{
  "name": "originalpal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "init": "node scripts/init.mjs",
    "bootstrap": "node scripts/bootstrap/index.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:changed": "node scripts/format-changed.mjs",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:deploy": "node scripts/migrate.mjs",
    "migrate:diff": "node scripts/migrate-diff.mjs",
    "db:seed": "node scripts/seed.mjs",
    "docker:build": "docker build -t originalpal:latest .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env originalpal:latest",
    "db:studio": "drizzle-kit studio",
    "seed": "pnpm db:seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
