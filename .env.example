# Local Docker Compose PostgreSQL. Change the development password before use.
POSTGRES_DB="originalpal"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="local-dev-change-me"
POSTGRES_PORT=5439
APP_PORT=3000

# Host-side URL for pnpm db/migration commands; Compose URL uses the internal service name.
DATABASE_URL="postgresql://postgres:local-dev-change-me@127.0.0.1:5439/originalpal"
DATABASE_URL_DOCKER="postgresql://postgres:local-dev-change-me@db:5432/originalpal"

# JWT auth
JWT_SECRET="app-dev-secret-minimum-32-characters!!"
JWT_ISSUER="originalpal-auth"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Bootstrap admin user (seeded via pnpm db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Secret1!234"

# File uploads (optional — defaults shown)
# UPLOAD_DIR="./uploads"
# UPLOAD_MAX_FILE_SIZE_BYTES=10485760

# Docker runtime (optional — used by docker-entrypoint.sh)
# RUN_MIGRATIONS=true
# RUN_SEED=false
# PORT=3000
# HOSTNAME=0.0.0.0

# Integration tests (optional — set RUN_DB_CONTRACT_TESTS=true to enable)
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/originalpal_test"
