{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindFunctions": ["cn", "clsx"],
  "tailwindStylesheet": "./src/app/globals.css",
  "importOrder": [
    "^node:",
    "^path$",
    "^next$",
    "^next/(.*)$",
    "^react$",
    "^react-dom$",
    "^react/(.*)$",
    "^zod$",
    "^jose$",
    "^@tanstack/react-query$",
    "^@codemirror/(.*)$",
    "^@uiw/(.*)$",
    "^cn$",
    "<THIRD_PARTY_MODULES>",
    "^@/lib/(.*)$",
    "^@/app/(.*)$",
    "^@/(.*)$",
    "^[./]"
  ]
}
